+/* --- SSO proxy -----------------------------------------------------------
+ * Forwards GET requests under /+CSCOE+/sso/ to the local portal (plain
+ * HTTP on loopback).
+ * The portal's response (status line, headers including Set-Cookie, and
+ * body) is relayed verbatim to the client's embedded browser. Requests are
+ * reconstructed with a minimal header set: the portal flow keeps all state
+ * in the URL (sid, state, code), so no client headers or cookies need to
+ * be forwarded.
+ */
+#define SSO_PROXY_MAX_RESPONSE (64 * 1024)
+#define SSO_PROXY_TIMEOUT_SEC 5
+
+static int write_all(int fd, const void *buf, size_t len)
+{
+	const char *p = buf;
+	ssize_t n;
+
+	while (len > 0) {
+		n = write(fd, p, len);
+		if (n == 0)
+			return -1;
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			return -1;
+		}
+		p += n;
+		len -= n;
+	}
+	return 0;
+}
+
+static int sso_proxy_fail(worker_st *ws, unsigned int http_ver)
+{
+	oclog(ws, LOG_INFO, "sso proxy: upstream unavailable");
+	cstp_cork(ws);
+	cstp_printf(ws,
+		    "HTTP/1.%u 502 Bad Gateway\r\n"
+		    "Content-Length: 0\r\n"
+		    "Connection: close\r\n\r\n",
+		    http_ver);
+	cstp_uncork(ws);
+	return -1;
+}
+
+int get_sso_proxy_handler(worker_st *ws, unsigned int http_ver)
+{
+	struct addrinfo hints, *res = NULL, *rp;
+	struct timeval tv;
+	char host[64];
+	char portstr[8];
+	char req[512];
+	uint8_t *resp = NULL;
+	size_t got = 0;
+	unsigned int port;
+	ssize_t n;
+	int fd = -1;
+	int ret;
+	unsigned int reqlen;
+
+	oclog(ws, LOG_HTTP_DEBUG, "sso proxy: GET %s", ws->req.url);
+
+	if (!sso_is_enabled())
+		return response_404(ws, http_ver);
+
+	if (ws->req.url[0] == 0 || strchr(ws->req.url, ' ') != NULL)
+		return response_404(ws, http_ver);
+
+	sso_proxy_target(host, sizeof(host), &port);
+	snprintf(portstr, sizeof(portstr), "%u", port);
+
+	memset(&hints, 0, sizeof(hints));
+	hints.ai_family = AF_INET;
+	hints.ai_socktype = SOCK_STREAM;
+	if (getaddrinfo(host, portstr, &hints, &res) != 0 || res == NULL)
+		goto fail;
+
+	fd = -1;
+	for (rp = res; rp != NULL; rp = rp->ai_next) {
+		fd = socket(rp->ai_family, rp->ai_socktype, rp->ai_protocol);
+		if (fd < 0)
+			continue;
+		tv.tv_sec = SSO_PROXY_TIMEOUT_SEC;
+		tv.tv_usec = 0;
+		setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+		setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+		if (connect(fd, rp->ai_addr, rp->ai_addrlen) == 0)
+			break;
+		close(fd);
+		fd = -1;
+	}
+	freeaddrinfo(res);
+	res = NULL;
+	if (fd < 0)
+		goto fail;
+
+	reqlen = snprintf(req, sizeof(req),
+			  "GET %s HTTP/1.1\r\n"
+			  "Host: %s:%u\r\n"
+			  "User-Agent: ocserv-sso-proxy/1.0\r\n"
+			  "X-Real-IP: %s\r\n"
+			  "Connection: close\r\n"
+			  "\r\n",
+			  ws->req.url, host, port, ws->remote_ip_str);
+	if (reqlen <= 0 || reqlen >= sizeof(req))
+		goto fail;
+
+	if (write_all(fd, req, reqlen) < 0)
+		goto fail;
+
+	resp = talloc_size(ws, SSO_PROXY_MAX_RESPONSE);
+	if (resp == NULL)
+		goto fail;
+
+	while (got < SSO_PROXY_MAX_RESPONSE) {
+		n = read(fd, resp + got, SSO_PROXY_MAX_RESPONSE - got);
+		if (n == 0)
+			break;
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			goto fail;
+		}
+		got += (size_t)n;
+	}
+
+	close(fd);
+	fd = -1;
+
+	if (got == 0)
+		goto fail;
+
+	oclog(ws, LOG_HTTP_DEBUG, "sso proxy: relayed %zu bytes", got);
+	cstp_cork(ws);
+	ret = cstp_send(ws, resp, got);
+	if (cstp_uncork(ws) < 0 || ret < 0)
+		goto fail_nofd;
+
+	talloc_free(resp);
+	return 0;
+
+fail:
+	if (res != NULL)
+		freeaddrinfo(res);
+	if (fd != -1)
+		close(fd);
+	talloc_free(resp);
+fail_nofd:
+	return sso_proxy_fail(ws, http_ver);
+}
+
+/* POST sibling of get_sso_proxy_handler: forwards /device/code and
+ * /device/token (vpn-cli Device Flow) to the local portal. Unlike the
+ * GET browser-leg proxy this forwards the request body so GitHub's
+ * device_code / grant response can round-trip. /introspect stays
+ * loopback-only (pam_exec hits it directly, never public). */
+int post_sso_proxy_handler(worker_st *ws, unsigned int http_ver)
+{
+	struct addrinfo hints, *res = NULL, *rp;
+	struct timeval tv;
+	char host[64];
+	char portstr[8];
+	char req[640];
+	uint8_t *resp = NULL;
+	size_t got = 0;
+	unsigned int port;
+	ssize_t n;
+	int fd = -1;
+	int ret;
+	unsigned int reqlen;
+	unsigned int blen = ws->req.body_length;
+
+	if (!sso_is_enabled())
+		return response_404(ws, http_ver);
+
+	if (ws->req.url[0] == 0 || strchr(ws->req.url, ' ') != NULL)
+		return response_404(ws, http_ver);
+
+	sso_proxy_target(host, sizeof(host), &port);
+	snprintf(portstr, sizeof(portstr), "%u", port);
+
+	memset(&hints, 0, sizeof(hints));
+	hints.ai_family = AF_INET;
+	hints.ai_socktype = SOCK_STREAM;
+	if (getaddrinfo(host, portstr, &hints, &res) != 0 || res == NULL)
+		goto fail;
+
+	fd = -1;
+	for (rp = res; rp != NULL; rp = rp->ai_next) {
+		fd = socket(rp->ai_family, rp->ai_socktype, rp->ai_protocol);
+		if (fd < 0)
+			continue;
+		tv.tv_sec = SSO_PROXY_TIMEOUT_SEC;
+		tv.tv_usec = 0;
+		setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+		setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+		if (connect(fd, rp->ai_addr, rp->ai_addrlen) == 0)
+			break;
+		close(fd);
+		fd = -1;
+	}
+	freeaddrinfo(res);
+	res = NULL;
+	if (fd < 0)
+		goto fail;
+
+	reqlen = snprintf(req, sizeof(req),
+			  "POST %s HTTP/1.1\r\n"
+			  "Host: %s:%u\r\n"
+			  "User-Agent: ocserv-sso-proxy/1.0\r\n"
+			  "X-Real-IP: %s\r\n"
+			  "Content-Type: application/x-www-form-urlencoded\r\n"
+			  "Content-Length: %u\r\n"
+			  "Connection: close\r\n"
+			  "\r\n",
+			  ws->req.url, host, port, ws->remote_ip_str, blen);
+	if (reqlen <= 0 || reqlen >= sizeof(req))
+		goto fail;
+
+	if (write_all(fd, req, reqlen) < 0)
+		goto fail;
+	if (blen > 0 && write_all(fd, ws->req.body, blen) < 0)
+		goto fail;
+
+	resp = talloc_size(ws, SSO_PROXY_MAX_RESPONSE);
+	if (resp == NULL)
+		goto fail;
+
+	while (got < SSO_PROXY_MAX_RESPONSE) {
+		n = read(fd, resp + got, SSO_PROXY_MAX_RESPONSE - got);
+		if (n == 0)
+			break;
+		if (n < 0) {
+			if (errno == EINTR)
+				continue;
+			goto fail;
+		}
+		got += (size_t)n;
+	}
+
+	close(fd);
+	fd = -1;
+
+	if (got == 0)
+		goto fail;
+
+	oclog(ws, LOG_HTTP_DEBUG, "sso proxy POST: relayed %zu bytes", got);
+	cstp_cork(ws);
+	ret = cstp_send(ws, resp, got);
+	if (cstp_uncork(ws) < 0 || ret < 0)
+		goto fail_nofd;
+
+	talloc_free(resp);
+	return 0;
+
+fail:
+	if (res != NULL)
+		freeaddrinfo(res);
+	if (fd != -1)
+		close(fd);
+	talloc_free(resp);
+fail_nofd:
+	return sso_proxy_fail(ws, http_ver);
+}
