+/* --- SSO (AnyConnect sso-v2 / single-sign-on-v2) support ----------------
+ * Configured via environment (worker inherits from main):
+ *   OCSERV_SSO_ENABLE=1|true      - master switch
+ *   OCSERV_SSO_BASE_URL           - public base URL, e.g. https://vpn.example.com
+ *   OCSERV_SSO_PROXY              - portal upstream, host:port (default 127.0.0.1:8443)
+ *
+ * Flow: when a client advertises the single-sign-on-v2 capability we reply
+ * with an sso-v2 form pointing at {BASE}/+CSCOE+/sso/start?sid=... (served
+ * by the portal through the /+CSCOE+/sso/ proxy route). The client opens
+ * its embedded browser; on completion the portal sets the acSamlv2Token
+ * cookie. The client then POSTs <sso-token>TOKEN</sso-token>, where
+ * TOKEN = user || sid || ticket with:
+ *   user   = base32(github login), chars [a-z2-7], variable length
+ *   sid    = 26 hex chars, generated per login form
+ *   ticket = 32 chars [0-9a-z], issued by the portal
+ * We split TOKEN into username/password (password = "sid.ticket") and feed
+ * both into the regular username/password auth path; the PAM backend
+ * (pam_exec helper) POSTs the password to the portal's /introspect.
+ */
+#define SSO_SID_LEN 26
+#define SSO_TICKET_LEN 32
+#define SSO_TOKEN_MIN (SSO_SID_LEN + SSO_TICKET_LEN + 1)
+
+struct sso_cfg_st {
+	unsigned int loaded;
+	unsigned int enabled;
+	char base_url[192];
+	char proxy_host[64];
+	unsigned int proxy_port;
+};
+
+static struct sso_cfg_st sso_cfg;
+
+static void sso_cfg_load(void)
+{
+	const char *env;
+
+	sso_cfg.loaded = 1;
+	sso_cfg.enabled = 0;
+
+	env = getenv("OCSERV_SSO_ENABLE");
+	if (env == NULL ||
+	    (strcmp(env, "1") != 0 && strcasecmp(env, "true") != 0))
+		return;
+
+	env = getenv("OCSERV_SSO_BASE_URL");
+	if (env == NULL || env[0] == 0 ||
+	    strlen(env) >= sizeof(sso_cfg.base_url))
+		return;
+	strlcpy(sso_cfg.base_url, env, sizeof(sso_cfg.base_url));
+
+	strlcpy(sso_cfg.proxy_host, "127.0.0.1", sizeof(sso_cfg.proxy_host));
+	sso_cfg.proxy_port = 8443;
+	env = getenv("OCSERV_SSO_PROXY");
+	if (env != NULL && env[0] != 0) {
+		char host[64];
+		unsigned int port;
+
+		if (sscanf(env, "%63[^:]:%u", host, &port) == 2 &&
+		    port > 0 && port < 65536) {
+			strlcpy(sso_cfg.proxy_host, host,
+				sizeof(sso_cfg.proxy_host));
+			sso_cfg.proxy_port = port;
+		}
+	}
+
+	sso_cfg.enabled = 1;
+}
+
+unsigned int sso_is_enabled(void)
+{
+	if (!sso_cfg.loaded)
+		sso_cfg_load();
+	return sso_cfg.enabled;
+}
+
+void sso_proxy_target(char *host, size_t host_size, unsigned int *port)
+{
+	if (!sso_cfg.loaded)
+		sso_cfg_load();
+	strlcpy(host, sso_cfg.proxy_host, host_size);
+	*port = sso_cfg.proxy_port;
+}
+
+static int sso_gen_sid(char *sid, size_t sid_size)
+{
+	uint8_t rnd[SSO_SID_LEN / 2];
+	unsigned int i;
+
+	if (sid_size < SSO_SID_LEN + 1)
+		return -1;
+	if (gnutls_rnd(GNUTLS_RND_NONCE, rnd, sizeof(rnd)) < 0)
+		return -1;
+	for (i = 0; i < sizeof(rnd); i++)
+		snprintf(&sid[i * 2], 3, "%02x", rnd[i]);
+	return 0;
+}
+
+/* TOKEN = user || sid || ticket, all alphanumeric; password = "sid.ticket" */
+static int sso_split_token(const char *tok, unsigned int toklen,
+			   char *user, size_t user_size, char *pass,
+			   size_t pass_size)
+{
+	unsigned int i, ulen;
+
+	if (toklen < SSO_TOKEN_MIN || toklen > SSO_TOKEN_MIN + 64)
+		return -1;
+
+	for (i = 0; i < toklen; i++) {
+		if (isalnum((unsigned char)tok[i]) == 0)
+			return -1;
+	}
+
+	ulen = toklen - SSO_SID_LEN - SSO_TICKET_LEN;
+	if (ulen + 1 > user_size)
+		return -1;
+	if (pass_size < SSO_SID_LEN + SSO_TICKET_LEN + 2)
+		return -1;
+
+	memcpy(user, tok, ulen);
+	user[ulen] = 0;
+
+	memcpy(pass, &tok[ulen], SSO_SID_LEN);
+	pass[SSO_SID_LEN] = '.';
+	memcpy(&pass[SSO_SID_LEN + 1], &tok[ulen + SSO_SID_LEN],
+	       SSO_TICKET_LEN);
+	pass[SSO_SID_LEN + 1 + SSO_TICKET_LEN] = 0;
+	return 0;
+}
+
+static unsigned int sso_client_capable(struct http_req_st *req)
+{
+	if (req->body == NULL || req->body_length == 0)
+		return 0;
+	if (memmem(req->body, req->body_length, "single-sign-on-v2",
+		   sizeof("single-sign-on-v2") - 1) != NULL)
+		return 1;
+	return 0;
+}
+
+/* returns the sso-token value from the reply body (talloc'd from the body),
+ * or NULL if absent */
+static char *sso_token_in_reply(worker_st *ws, struct http_req_st *req)
+{
+	char *tok = NULL;
+
+	if (req->body == NULL || req->body_length == 0)
+		return NULL;
+	if (parse_reply(ws, req->body, req->body_length, "sso-token",
+			sizeof("sso-token") - 1, "sso-token",
+			sizeof("sso-token") - 1, &tok) < 0)
+		return NULL;
+	if (tok == NULL || tok[0] == 0)
+		return NULL;
+	return tok;
+}
+
+static int sso_append_login_form(worker_st *ws, str_st *str)
+{
+	int ret;
+	char sid[SSO_SID_LEN + 1];
+	unsigned long long chash;
+	const char *dh = NULL;
+	char dhurl[256];
+	char external_mode = 0;
+	char sso_base[300];
+	const char *base;
+
+	if (sso_gen_sid(sid, sizeof(sid)) < 0)
+		return -1;
+	strlcpy(ws->sso_sid, sid, sizeof(ws->sso_sid));
+
+	/* Build the sso URLs on the host the client actually connected to
+	 * (Host header) — clients refuse to open the browser for a login
+	 * URL on a different host than the VPN server they dialed. */
+	if (ws->req.raw_hostname[0] != 0) {
+		snprintf(sso_base, sizeof(sso_base), "https://%s",
+			 ws->req.raw_hostname);
+		base = sso_base;
+	} else {
+		base = sso_cfg.base_url;
+	}
+
+	if (ws->req.strap_dh_pubkey_set && ws->req.is_mobile == 0) {
+		/* external-browser (STRAP) mode for desktop clients: pass the
+		 * client's DH pubkey to the portal in the login URL (base64url)
+		 * so it can ECIES-encrypt the sso token back via
+		 * localhost:29786. Mobile clients use the embedded in-app
+		 * browser (their system browser shares the sandbox and the
+		 * localhost listener is unreachable from it). */
+		unsigned int i, o = 0;
+
+		for (i = 0; ws->req.strap_dh_pubkey[i] != 0 && o < sizeof(dhurl) - 1; i++) {
+			char c = ws->req.strap_dh_pubkey[i];
+			if (c == '+')
+				c = '-';
+			else if (c == '/')
+				c = '_';
+			else if (c == '=')
+				break;
+			dhurl[o++] = c;
+		}
+		dhurl[o] = 0;
+		if (o > 0) {
+			dh = dhurl;
+			external_mode = 1;
+		}
+	}
+
+	/* config-hash mimics ASA (monotonic value); clients echo it back */
+	chash = (unsigned long long)time(NULL);
+
+	/* Structure mirrors a real ASA capture (openconnect MR !75):
+	 * aggregate-auth-version="2" attribute and <opaque> as a direct
+	 * child of <config-auth>, BEFORE <auth>. */
+	ret = str_append_str(str,
+			     "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+			     "<config-auth client=\"vpn\" type=\"auth-request\" "
+			     "aggregate-auth-version=\"2\">\n"
+			     VERSION_MSG
+			     "<opaque is-for=\"sg\">"
+			     "<tunnel-group>standard-group</tunnel-group>"
+			     "<auth-method>single-sign-on-v2</auth-method>");
+	if (ret < 0)
+		return -1;
+
+	ret = str_append_printf(str, "<config-hash>%llu</config-hash></opaque>\n",
+				chash);
+	if (ret < 0)
+		return -1;
+
+	ret = str_append_str(str,
+			     "<auth id=\"main\">\n"
+			     "<title>Login</title>\n"
+			     "<message>Please complete the authentication "
+			     "process in the AnyConnect Login window."
+			     "</message>\n"
+			     "<banner></banner>\n");
+	if (ret < 0)
+		return -1;
+
+	ret = str_append_printf(
+		str,
+		"<sso-v2-login>%s/+CSCOE+/sso/start?sid=%s%s%s</sso-v2-login>\n"
+		"<sso-v2-login-final>%s/+CSCOE+/sso/done</sso-v2-login-final>\n"
+		"<sso-v2-logout>%s/+CSCOE+/sso/logout</sso-v2-logout>\n"
+		"<sso-v2-logout-final>%s/+CSCOE+/sso/done"
+		"</sso-v2-logout-final>\n",
+		base, sid, dh ? "&amp;dh=" : "", dh ? dh : "",
+		base, base, base);
+	if (ret < 0)
+		return -1;
+
+	ret = str_append_str(str,
+			     "<sso-v2-token-cookie-name>acSamlv2Token"
+			     "</sso-v2-token-cookie-name>\n"
+			     "<sso-v2-error-cookie-name>acSamlv2Error"
+			     "</sso-v2-error-cookie-name>\n");
+	if (ret < 0)
+		return -1;
+
+	if (external_mode) {
+		ret = str_append_str(str,
+				     "<sso-v2-browser-mode>external"
+				     "</sso-v2-browser-mode>\n");
+		if (ret < 0)
+			return -1;
+	}
+
+	ret = str_append_str(str,
+			     "<form method=\"post\" action=\"/auth\">\n"
+			     "<input type=\"sso\" name=\"sso-token\">"
+			     "</input>\n");
+	if (ret < 0)
+		return -1;
+
+	ret = str_append_str(str, OC_LOGIN_END);
+	if (ret < 0)
+		return -1;
+
+	return 0;
+}
