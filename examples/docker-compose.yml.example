services:
  # ocserv-sso 单容器: ocserv + vpn-portal (uvicorn 127.0.0.1:8443) 同一镜像.
  # build context 是仓库根 (需要 ocserv/ + portal/ + single/).
  ocserv-sso:
    build:
      context: .
      dockerfile: single/Dockerfile
      args:
        APT_MIRROR: ${APT_MIRROR-}
    container_name: ocserv-sso
    restart: unless-stopped
    # host network: ocserv 直接监听宿主机 443; portal 走 loopback 127.0.0.1:8443,
    # 浏览器腿由 ocserv /+CSCOE+/sso/ 反代, pam_exec helper 直连 loopback.
    network_mode: host
    environment:
      - SSO_BASE_URL=https://vpn.example.com
      - SSO_BIND=127.0.0.1
      - SSO_PORT=8443
      # 允许登录的 GitHub org 列表 (逗号分隔, 任一 active 成员即放行).
      - GITHUB_ORGS=example-org
      - OCSERV_SSO_ENABLE=1
      - OCSERV_SSO_BASE_URL=https://vpn.example.com
    volumes:
      - /etc/letsencrypt:/etc/letsencrypt:ro
      - ./ocserv.conf:/usr/local/etc/ocserv/ocserv.conf:ro
      # secrets 只读文件挂载 (不用 env — docker inspect 会泄露 Config.Env)
      - /run/secrets/github_oauth_client_id:/run/secrets/github_oauth_client_id:ro
      - /run/secrets/github_oauth_client_secret:/run/secrets/github_oauth_client_secret:ro
      - /run/secrets/verifier_token:/run/secrets/verifier_token:ro
      - /run/secrets/sso_hmac_key:/run/secrets/sso_hmac_key:ro
    devices:
      - /dev/net/tun:/dev/net/tun
    cap_add:
      - NET_ADMIN
    # NOTE: 不设 sysctls: net.ipv4.ip_forward=1 —— runc 在 network_mode: host 下
    # 拒绝 net.* sysctl, 容器无法启动. IP 转发在宿主机设:
    #   sysctl -w net.ipv4.ip_forward=1
    logging:
      driver: journald
      options:
        tag: ocserv-sso
